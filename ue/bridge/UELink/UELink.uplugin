{
  "FileVersion": 3,
  "Version": 38,
  "VersionName": "2.14.1",
  "FriendlyName": "UELink",
  "Description": "让 Agent 面板连上这个 UE 进程：控制台、GM、对象属性、DataTable、资源和蓝图读写、日志、性能、Lua；UEKit 的其他插件也通过它和面板通信。只监听 127.0.0.1，Shipping 不加载。",
  "Category": "Developer Tools",
  "CreatedBy": "fixcode-h",
  "CreatedByURL": "https://github.com/fixcode-h/UEKit",
  "DocsURL": "https://github.com/fixcode-h/UEKit/tree/main/plugins/UELink",
  "CanContainContent": false,
  "Installed": false,
  "EnabledByDefault": true,
  "Modules": [
    {
      "Name": "UELinkCore",
      "Type": "Runtime",
      "LoadingPhase": "Default",
      "TargetConfigurationDenyList": ["Shipping"]
    },
    {
      "Name": "UELinkEditor",
      "Type": "Editor",
      "LoadingPhase": "Default"
    }
  ],
  "Plugins": [
    { "Name": "UnLua", "Enabled": true, "Optional": true }
  ]
}
