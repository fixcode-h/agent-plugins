{
  "kind": "gametest-scenario",
  "schemaVersion": 4,
  "name": "AssetForge 示例界面：脚本流程",
  "_note": "配套「流程」页（AssetForge 1.5.0 起）。把 GameTest 脚本的能力过一遍：参数和变量、子脚本 call / return、对象定位器、invoke 调界面函数、接口和表达式、loop 四种写法和 break / continue、if / elif / else、已达成就跳过（skipIf + also）、等待条件、守护处理定时弹出的公告、块级重试和时限、expectNoErrors、disabled、widget.call。",
  "revision": 1,
  "tags": [
    "sample",
    "assetforge",
    "script"
  ],
  "stepDelayMs": 200,
  "params": {
    "times": {
      "default": 3,
      "type": "int",
      "note": "「计数」先按几次 +1"
    },
    "claims": {
      "default": [
        "Daily",
        "Weekly",
        "Mail"
      ],
      "type": "any",
      "note": "要领取的项（Claim_<项>）"
    }
  },
  "vars": {
    "tipWas": "",
    "total": 0
  },
  "objects": {
    "screen": {
      "class": "ForgeSampleScreen",
      "in": "screen",
      "many": "first"
    }
  },
  "guards": [
    {
      "id": "notice",
      "name": "活动公告弹出来了",
      "when": {
        "obj": {
          "class": "WBP_ForgeSample"
        },
        "prop": "@Popup_Notice:shown",
        "op": "is",
        "value": true
      },
      "do": [
        {
          "action": "click",
          "target": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "part": "Close_Popup_Notice__Ok"
          }
        }
      ],
      "check": "both",
      "after": "retry",
      "max": 5,
      "cooldownMs": 500,
      "note": "「1 秒后弹公告」按钮弹的公告随时会挡住界面：不管在做哪一步，看到就点「知道了」"
    }
  ],
  "steps": [
    {
      "id": "open",
      "action": "call",
      "script": "AssetForgeSample/common/打开示例界面",
      "with": {
        "nav": "Go_Page_Flow__Nav",
        "title": "流程"
      },
      "saveAs": "opened",
      "note": "进图、重置示例界面、切到「流程」页"
    },
    {
      "id": "openedFlow",
      "action": "assert",
      "expr": "$opened == '流程'",
      "note": "子脚本的返回值存在 $opened"
    },
    {
      "id": "count",
      "action": "group",
      "name": "计数：四种循环、break / continue",
      "expectNoErrors": true,
      "do": [
        {
          "id": "incTimes",
          "action": "loop",
          "times": "$times",
          "do": [
            {
              "id": "inc1",
              "action": "click",
              "target": {
                "obj": {
                  "class": "WBP_ForgeSample"
                },
                "part": "Page_Flow.Inc_Counter"
              }
            }
          ]
        },
        {
          "id": "countIsTimes",
          "action": "assert",
          "cond": {
            "expr": "num(prop({\"class\":\"WBP_ForgeSample\"}, \"@Page_Flow.Counter:text\")) == \"$times\""
          }
        },
        {
          "id": "incUntil",
          "action": "loop",
          "until": {
            "expr": "num(prop({\"class\":\"WBP_ForgeSample\"}, \"@Page_Flow.Counter:text\")) >= 5",
            "settleMs": 0
          },
          "max": 10,
          "do": [
            {
              "id": "inc2",
              "action": "click",
              "target": {
                "obj": {
                  "class": "WBP_ForgeSample"
                },
                "part": "Page_Flow.Inc_Counter"
              }
            }
          ],
          "note": "按到 5 为止：每轮做完再看"
        },
        {
          "id": "decWhile",
          "action": "loop",
          "while": {
            "expr": "num(prop({\"class\":\"WBP_ForgeSample\"}, \"@Page_Flow.Counter:text\")) > 2"
          },
          "max": 10,
          "do": [
            {
              "id": "dec1",
              "action": "click",
              "target": {
                "obj": {
                  "class": "WBP_ForgeSample"
                },
                "part": "Page_Flow.Dec_Counter"
              }
            }
          ],
          "note": "大于 2 就继续减：每轮开始前看"
        },
        {
          "id": "atTwo",
          "action": "assert",
          "expr": "num(prop({\"class\":\"WBP_ForgeSample\"}, \"@Page_Flow.Counter:text\")) == 2"
        },
        {
          "id": "addEach",
          "action": "loop",
          "in": [
            1,
            2,
            3
          ],
          "as": "step",
          "do": [
            {
              "id": "addStep",
              "action": "obj.call",
              "function": "AddCounter",
              "args": {
                "InDelta": "$step"
              },
              "saveAs": "last",
              "obj": "screen"
            }
          ],
          "note": "逐个加 1、2、3：调界面上的 BlueprintCallable 函数，返回值存 $last"
        },
        {
          "id": "lastIs8",
          "action": "assert",
          "expr": "$last == 8 and num(prop({\"class\":\"WBP_ForgeSample\"}, \"@Page_Flow.Counter:text\")) == 8"
        },
        {
          "id": "getCounter",
          "action": "obj.call",
          "function": "GetCounter",
          "saveAs": "got",
          "expect": {
            "equals": 8
          },
          "obj": "screen"
        },
        {
          "id": "double",
          "action": "set",
          "var": "doubled",
          "value": "=$got * 2"
        },
        {
          "id": "doubledIs16",
          "action": "assert",
          "value": "$doubled",
          "equals": 16
        },
        {
          "id": "zero",
          "action": "obj.call",
          "function": "SetCounter",
          "args": {
            "InValue": 0
          },
          "obj": "screen"
        },
        {
          "id": "evenOnly",
          "action": "loop",
          "times": 10,
          "note": "只在偶数轮 +1，到 3 就出循环：第 0、2、4 轮各加一次",
          "do": [
            {
              "id": "skipOdd",
              "action": "continue",
              "cond": {
                "expr": "$index % 2 == 1"
              }
            },
            {
              "id": "inc3",
              "action": "click",
              "target": {
                "obj": {
                  "class": "WBP_ForgeSample"
                },
                "part": "Page_Flow.Inc_Counter"
              }
            },
            {
              "id": "enough",
              "action": "break",
              "cond": {
                "expr": "num(prop({\"class\":\"WBP_ForgeSample\"}, \"@Page_Flow.Counter:text\")) >= 3"
              }
            }
          ]
        },
        {
          "id": "countIs3",
          "action": "assert",
          "value": "@obj.screen.Counter",
          "equals": 3,
          "note": "直接读界面的 UPROPERTY"
        }
      ]
    },
    {
      "id": "branch",
      "action": "group",
      "name": "分支：if / elif / else",
      "do": [
        {
          "id": "byCount",
          "action": "if",
          "cond": {
            "expr": "num(prop({\"class\":\"WBP_ForgeSample\"}, \"@Page_Flow.Counter:text\")) >= 5"
          },
          "then": [
            {
              "id": "tooMany",
              "action": "fail",
              "message": "='计数不该到 5：' + prop({\"class\":\"WBP_ForgeSample\"}, \"@Page_Flow.Counter:text\")"
            }
          ],
          "elif": [
            {
              "cond": {
                "expr": "num(prop({\"class\":\"WBP_ForgeSample\"}, \"@Page_Flow.Counter:text\")) == 3"
              },
              "then": [
                {
                  "id": "isThree",
                  "action": "mark",
                  "text": "计数是 3，走 elif"
                }
              ]
            }
          ],
          "else": [
            {
              "id": "unexpected",
              "action": "fail",
              "message": "='计数应该是 3，实际 ' + prop({\"class\":\"WBP_ForgeSample\"}, \"@Page_Flow.Counter:text\")"
            }
          ]
        },
        {
          "id": "showTip",
          "action": "click",
          "target": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "part": "Page_Flow.Toggle_Reveal_Tip"
          }
        },
        {
          "id": "byTip",
          "action": "if",
          "branch": "state",
          "cond": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "prop": "@Page_Flow.Reveal_Tip:shown",
            "op": "is",
            "value": true
          },
          "then": [
            {
              "id": "tipShown",
              "action": "set",
              "var": "tipWas",
              "value": "shown"
            },
            {
              "id": "hideTip",
              "action": "click",
              "target": {
                "obj": {
                  "class": "WBP_ForgeSample"
                },
                "part": "Page_Flow.Toggle_Reveal_Tip"
              }
            }
          ],
          "else": [
            {
              "id": "tipHidden",
              "action": "set",
              "var": "tipWas",
              "value": "hidden"
            }
          ]
        },
        {
          "id": "tipGone",
          "action": "assert",
          "cond": {
            "all": [
              {
                "expr": "$tipWas == 'shown'"
              },
              {
                "not": {
                  "obj": {
                    "class": "WBP_ForgeSample"
                  },
                  "prop": "@Page_Flow.Reveal_Tip:shown",
                  "op": "is",
                  "value": true
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "claim",
      "action": "group",
      "name": "领取：已达成就跳过",
      "do": [
        {
          "id": "claimAll",
          "action": "loop",
          "in": "$claims",
          "as": "what",
          "note": "按钮字变成「已领取」就是领过了：第二轮全部跳过（状态记「已达成」，算通过）",
          "do": [
            {
              "id": "claimOne",
              "action": "click",
              "target": {
                "obj": {
                  "class": "WBP_ForgeSample"
                },
                "part": "Page_Flow.Claim_$what"
              },
              "skipIf": {
                "obj": {
                  "class": "WBP_ForgeSample"
                },
                "prop": "@Page_Flow.Claim_$what:text",
                "op": "contains",
                "value": "已领取"
              }
            }
          ]
        },
        {
          "id": "claimedAll",
          "action": "assert",
          "expr": "contains(prop({\"class\":\"WBP_ForgeSample\"}, \"@Status:text\"), '共领了 3 个')"
        },
        {
          "id": "claimAgain",
          "action": "loop",
          "in": "$claims",
          "as": "what",
          "do": [
            {
              "id": "claimTwice",
              "action": "click",
              "target": {
                "obj": {
                  "class": "WBP_ForgeSample"
                },
                "part": "Page_Flow.Claim_$what"
              },
              "skipIf": {
                "obj": {
                  "class": "WBP_ForgeSample"
                },
                "prop": "@Page_Flow.Claim_$what:text",
                "op": "contains",
                "value": "已领取"
              }
            }
          ]
        },
        {
          "id": "claimCount",
          "action": "assert",
          "cond": {
            "all": [
              {
                "value": "@obj.screen.ClaimCount",
                "equals": 3
              },
              {
                "expr": "@obj.screen.IsClaimed('Mail')"
              }
            ]
          }
        },
        {
          "id": "claimWithAlso",
          "action": "click",
          "target": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "part": "Page_Flow.Claim_Daily"
          },
          "skipIf": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "prop": "@Page_Flow.Claim_Daily:text",
            "op": "contains",
            "value": "已领取",
            "also": 1
          },
          "note": "领过了就连下一步一起跳过（also）"
        },
        {
          "id": "neverRuns",
          "action": "fail",
          "message": "应该随上一步一起跳过"
        }
      ]
    },
    {
      "id": "waiting",
      "action": "group",
      "name": "等待：延时出现的宝箱",
      "timeoutMs": 20000,
      "do": [
        {
          "id": "delayLoot",
          "action": "click",
          "target": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "part": "Page_Flow.Delay_Reveal_Loot"
          },
          "note": "1.5 秒后才出现"
        },
        {
          "id": "notYet",
          "action": "assert",
          "cond": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "prop": "@Page_Flow.Reveal_Loot:shown",
            "op": "is",
            "value": false
          }
        },
        {
          "id": "waitLoot",
          "action": "wait",
          "until": "cond",
          "cond": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "prop": "@Page_Flow.Reveal_Loot:shown",
            "op": "is",
            "value": true
          },
          "timeoutMs": 5000
        },
        {
          "id": "openLoot",
          "action": "click",
          "target": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "part": "Page_Flow.Open_Popup_Reward__Loot"
          }
        },
        {
          "id": "rewardShown",
          "action": "assert",
          "cond": {
            "all": [
              {
                "obj": {
                  "class": "WBP_ForgeSample"
                },
                "prop": "@Popup_Reward:shown",
                "op": "is",
                "value": true
              },
              {
                "obj": {
                  "class": "WBP_ForgeSample"
                },
                "prop": "@Popup_Reward_Subject:text",
                "op": "contains",
                "value": "宝箱"
              }
            ]
          }
        },
        {
          "id": "takeReward",
          "action": "click",
          "target": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "part": "Close_Popup_Reward__Ok"
          }
        },
        {
          "id": "rewardGone",
          "action": "wait",
          "until": "cond",
          "cond": {
            "not": {
              "obj": {
                "class": "WBP_ForgeSample"
              },
              "prop": "@Popup_Reward:shown",
              "op": "is",
              "value": true
            }
          }
        },
        {
          "id": "pause",
          "action": "wait",
          "until": "seconds",
          "seconds": 0.3
        },
        {
          "id": "pauseApi",
          "action": "api",
          "api": "Wait.Seconds",
          "args": {
            "n": 0.2
          }
        }
      ]
    },
    {
      "id": "guard",
      "action": "group",
      "name": "守护：定时弹出的公告",
      "do": [
        {
          "id": "armNotice",
          "action": "click",
          "target": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "part": "Page_Flow.Arm_Popup_Notice"
          },
          "note": "1 秒后弹公告"
        },
        {
          "id": "letItPop",
          "action": "wait",
          "until": "seconds",
          "seconds": 2,
          "note": "等待中守护每 0.2 秒看一次：公告一出来就被关掉"
        },
        {
          "id": "noticeGone",
          "action": "assert",
          "cond": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "prop": "@Popup_Notice:shown",
            "op": "is",
            "value": false
          }
        },
        {
          "id": "noticeHandled",
          "action": "assert",
          "expr": "contains(prop({\"class\":\"WBP_ForgeSample\"}, \"@Status:text\"), '活动公告')"
        }
      ]
    },
    {
      "id": "apis",
      "action": "group",
      "name": "接口和表达式",
      "do": [
        {
          "id": "markLog",
          "action": "api",
          "api": "Log.Mark",
          "saveAs": "logMark"
        },
        {
          "id": "inc4",
          "action": "click",
          "target": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "part": "Page_Flow.Inc_Counter"
          }
        },
        {
          "id": "logged",
          "action": "api",
          "api": "Log.Contains",
          "args": {
            "text": "计数 = 4",
            "since": "$logMark"
          },
          "expect": {
            "equals": true
          },
          "note": "示例界面把状态栏的话也写进日志"
        },
        {
          "id": "shown",
          "action": "assert",
          "cond": {
            "api": "Widget.IsShown",
            "args": {
              "target": "WBP_ForgeSample"
            }
          }
        },
        {
          "id": "readText",
          "action": "api",
          "api": "Widget.Text",
          "args": {
            "target": {
              "obj": {
                "class": "WBP_ForgeSample"
              },
              "part": "Page_Flow.Counter"
            }
          },
          "saveAs": "counterText"
        },
        {
          "id": "textIsNum",
          "action": "assert",
          "expr": "num($counterText) == num(prop({\"class\":\"WBP_ForgeSample\"}, \"@Page_Flow.Counter:text\")) and len($counterText) == 1"
        },
        {
          "id": "mapName",
          "action": "api",
          "api": "World.Map",
          "saveAs": "mapName"
        },
        {
          "id": "netMode",
          "action": "api",
          "api": "Net.Mode",
          "expect": {
            "equals": "standalone"
          }
        },
        {
          "id": "fps",
          "action": "api",
          "api": "Perf.Fps",
          "saveAs": "fps"
        },
        {
          "id": "seed",
          "action": "api",
          "api": "Random.Seed",
          "args": {
            "n": 42
          }
        },
        {
          "id": "cvar",
          "action": "api",
          "api": "CVar.Get",
          "args": {
            "name": "t.MaxFPS"
          },
          "saveAs": "maxFps"
        },
        {
          "id": "exprs",
          "action": "assert",
          "cond": {
            "all": [
              {
                "expr": "contains($mapName, 'Map_ForgeSample')"
              },
              {
                "expr": "$fps > 0"
              },
              {
                "expr": "format('{0}-{1}', upper('ab'), len([1, 2, 3])) == 'AB-3'"
              },
              {
                "expr": "join(split('a,b,c', ','), '|') == 'a|b|c' and trim('  x ') == 'x'"
              },
              {
                "expr": "clamp(round(3.14159, 2) * 10, 0, 30) == 30 and abs(-2) == 2 and max(1, 5, 3) == 5"
              },
              {
                "any": [
                  {
                    "expr": "'流程' in prop({\"class\":\"WBP_ForgeSample\"}, \"@Crumb:text\")"
                  },
                  {
                    "obj": {
                      "class": "WBP_ForgeSample"
                    },
                    "prop": "@Crumb:text",
                    "op": "eq",
                    "value": "首页"
                  }
                ]
              },
              {
                "not": {
                  "expr": "startsWith(prop({\"class\":\"WBP_ForgeSample\"}, \"@Status:text\"), 'xyz')"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "robust",
      "action": "group",
      "name": "容错：块级重试、时限、继续、跳过、禁用",
      "onFail": "retry",
      "retries": 2,
      "timeoutMs": 30000,
      "do": [
        {
          "id": "consoleCvar",
          "action": "console",
          "command": "t.MaxFPS",
          "expectContains": "MaxFPS",
          "onFail": "continue",
          "note": "控制台查变量；输出格式因引擎版本略有不同，失败只记一条不停下"
        },
        {
          "id": "skipDone",
          "action": "click",
          "target": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "part": "Page_Flow.Claim_Weekly"
          },
          "skipIf": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "prop": "@Page_Flow.Claim_Weekly:text",
            "op": "contains",
            "value": "已领取",
            "settleMs": 200
          }
        },
        {
          "id": "disabledStep",
          "action": "fail",
          "message": "禁用的步骤不执行",
          "disabled": true
        },
        {
          "id": "stillOk",
          "action": "assert",
          "expr": "num(prop({\"class\":\"WBP_ForgeSample\"}, \"@Page_Flow.Counter:text\")) == 4"
        }
      ]
    },
    {
      "id": "reset",
      "action": "group",
      "name": "重置：调界面上的无参函数",
      "do": [
        {
          "id": "resetFlow",
          "action": "obj.call",
          "function": "ResetFlow",
          "obj": {
            "class": "WBP_ForgeSample"
          }
        },
        {
          "id": "cleared",
          "action": "assert",
          "cond": {
            "all": [
              {
                "obj": {
                  "class": "WBP_ForgeSample"
                },
                "prop": "@Page_Flow.Counter:text",
                "op": "eq",
                "value": "0"
              },
              {
                "obj": {
                  "class": "WBP_ForgeSample"
                },
                "prop": "@Page_Flow.Claim_Daily:text",
                "op": "matches",
                "value": "^领取"
              },
              {
                "obj": {
                  "class": "WBP_ForgeSample"
                },
                "prop": "@Page_Flow.Reveal_Loot:shown",
                "op": "is",
                "value": false
              }
            ]
          }
        },
        {
          "id": "stopEarly",
          "action": "return",
          "cond": {
            "expr": "$tipWas != 'shown'"
          },
          "note": "条件成立时提前结束（这里不成立，接着收尾）"
        }
      ]
    },
    {
      "id": "close",
      "action": "group",
      "name": "截图收尾",
      "do": [
        {
          "id": "shot",
          "action": "screenshot",
          "name": "forge-sample-flow"
        },
        {
          "id": "stop",
          "action": "pie.stop"
        },
        {
          "id": "stopped",
          "action": "wait",
