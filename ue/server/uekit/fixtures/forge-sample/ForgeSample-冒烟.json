{
  "kind": "gametest-scenario",
  "schemaVersion": 5,
  "name": "AssetForge 示例界面：跳页、弹窗、返回",
  "_note": "配套 AssetForge 示例测试界面（先在 AssetForge 页导入 Test/umg/WBP_ForgeSample.json，会连带导入 pages/ 下的子页面；再导入 map/）。每页一段 group、参数和变量、表达式断言、loop until 连按返回、块里的守护。",
  "revision": 3,
  "tags": [
    "sample",
    "assetforge",
    "smoke"
  ],
  "stepDelayMs": 200,
  "params": {
    "playerName": {
      "default": "Tester01",
      "type": "string",
      "note": "资料页填的名字"
    },
    "quality": {
      "default": "极高",
      "type": "string",
      "note": "设置页视频画质选哪一档"
    }
  },
  "steps": [
    {
      "id": "open",
      "action": "call",
      "script": "AssetForgeSample/common/打开示例界面",
      "with": {},
      "saveAs": "opened",
      "note": "进图、重置示例界面"
    },
    {
      "id": "shop",
      "action": "group",
      "name": "商店：买红宝石，弹窗上再叠一层",
      "do": [
        {
          "id": "goShop",
          "action": "click",
          "target": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "part": "Page_Home.Go_Page_Shop__Hero"
          },
          "note": "首页大图上的「去商店」"
        },
        {
          "id": "atShop",
          "action": "assert",
          "cond": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "prop": "@/Crumb:text",
            "op": "eq",
            "value": "商店"
          }
        },
        {
          "id": "buyGem",
          "action": "click",
          "target": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "part": "Page_Shop.Open_Popup_Buy__Gem"
          },
          "note": "买红宝石"
        },
        {
          "id": "buyShown",
          "action": "assert",
          "note": "购买弹窗出来了，而且买的是红宝石",
          "cond": {
            "all": [
              {
                "obj": {
                  "class": "WBP_ForgeSample"
                },
                "prop": "@/Popup_Buy:shown",
                "op": "is",
                "value": true
              },
              {
                "obj": {
                  "class": "WBP_ForgeSample"
                },
                "prop": "@/Popup_Buy_Subject:text",
                "op": "contains",
                "value": "红宝石"
              }
            ]
          }
        },
        {
          "id": "openHelp",
          "action": "click",
          "target": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "part": "Open_Popup_Help__Buy"
          },
          "note": "弹窗上再弹一层说明"
        },
        {
          "id": "helpShown",
          "action": "assert",
          "cond": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "prop": "@/Popup_Help:shown",
            "op": "is",
            "value": true
          }
        },
        {
          "id": "backHelp",
          "action": "click",
          "target": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "part": "Back"
          },
          "note": "返回先关最上面的弹窗"
        },
        {
          "id": "buyStill",
          "action": "assert",
          "cond": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "prop": "@/Popup_Buy:shown",
            "op": "is",
            "value": true
          }
        },
        {
          "id": "buyOk",
          "action": "click",
          "target": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "part": "Close_Popup_Buy__Ok"
          }
        },
        {
          "id": "buyClosed",
          "action": "assert",
          "expr": "contains(prop({\"class\":\"WBP_ForgeSample\"}, \"@/Status:text\"), '关闭')"
        }
      ]
    },
    {
      "id": "settings",
      "action": "group",
      "name": "设置：视频画质",
      "do": [
        {
          "id": "goSettings",
          "action": "click",
          "target": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "part": "Go_Page_Settings__Nav"
          }
        },
        {
          "id": "goVideo",
          "action": "click",
          "target": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "part": "Page_Settings.Go_Tab_Video"
          }
        },
        {
          "id": "setQuality",
          "action": "set",
          "target": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "part": "Page_Settings.Quality"
          },
          "option": "$quality"
        },
        {
          "id": "qualityEcho",
          "action": "assert",
          "cond": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "prop": "@/Page_Settings/Quality_Value:text",
            "op": "eq",
            "value": "$quality"
          }
        }
      ]
    },
    {
      "id": "profile",
      "action": "group",
      "name": "资料：改名后返回",
      "do": [
        {
          "id": "goProfile",
          "action": "click",
          "target": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "part": "Go_Page_Profile__Nav"
          }
        },
        {
          "id": "typeName",
          "action": "type",
          "target": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "part": "Page_Profile.PlayerName"
          },
          "text": "$playerName"
        },
        {
          "id": "submitName",
          "action": "click",
          "target": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "part": "Page_Profile.Submit_PlayerName"
          }
        },
        {
          "id": "readEcho",
          "action": "set",
          "var": "echo",
          "note": "把回显的名字读进变量，下一步拿它和参数比",
          "value": "=prop({\"class\":\"WBP_ForgeSample\"}, \"@/Page_Profile/PlayerName_Echo:text\")"
        },
        {
          "id": "echoOk",
          "action": "assert",
          "expr": "$echo == $playerName"
        },
        {
          "id": "backToSettings",
          "action": "click",
          "target": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "part": "Back"
          }
        },
        {
          "id": "atSettings",
          "action": "assert",
          "cond": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "prop": "@/Crumb:text",
            "op": "eq",
            "value": "设置"
          }
        }
      ]
    },
    {
      "id": "tasks",
      "action": "group",
      "name": "任务：进详情、跳商店、连按返回回到任务页",
      "guards": [
        {
          "id": "strayBuy",
          "name": "购买弹窗残留",
          "when": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "prop": "@/Popup_Buy:shown",
            "op": "is",
            "value": true
          },
          "do": [
            {
              "action": "click",
              "target": {
                "obj": {
                  "class": "WBP_ForgeSample"
                },
                "part": "Close_Popup_Buy__Ok"
              }
            }
          ],
          "unlessStepTargets": false,
          "max": 3,
          "note": "这一段不该有购买弹窗：万一残留挡住了导航，先关掉再接着做"
        }
      ],
      "do": [
        {
          "id": "goTasks",
          "action": "click",
          "target": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "part": "Go_Page_Tasks__Nav"
          }
        },
        {
          "id": "goWeekly",
          "action": "click",
          "target": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "part": "Page_Tasks.Go_Tab_Weekly"
          }
        },
        {
          "id": "openDetail",
          "action": "click",
          "target": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "part": "Page_Tasks.Go_Page_TaskDetail__Weekly1"
          },
          "note": "从任务列表进详情页（侧栏里没有这一页）"
        },
        {
          "id": "atDetail",
          "action": "assert",
          "cond": {
            "all": [
              {
                "obj": {
                  "class": "WBP_ForgeSample"
                },
                "prop": "@/Crumb:text",
                "op": "eq",
                "value": "任务详情"
              },
              {
                "obj": {
                  "class": "WBP_ForgeSample"
                },
                "prop": "@/Page_TaskDetail/Page_TaskDetail_Subject:text",
                "op": "contains",
                "value": "熔火之心"
              }
            ]
          }
        },
        {
          "id": "detailToShop",
          "action": "click",
          "target": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "part": "Page_TaskDetail.Go_Page_Shop__Task"
          }
        },
        {
          "id": "atShop2",
          "action": "assert",
          "cond": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "prop": "@/Crumb:text",
            "op": "eq",
            "value": "商店"
          }
        },
        {
          "id": "backHome",
          "action": "loop",
          "until": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "prop": "@/Crumb:text",
            "op": "eq",
            "value": "任务"
          },
          "max": 4,
          "note": "返回历史：商店 → 任务详情 → 任务，按到回到任务页为止",
          "do": [
            {
              "id": "pressBack",
              "action": "click",
              "target": {
                "obj": {
                  "class": "WBP_ForgeSample"
                },
                "part": "Back"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "close",
      "action": "group",
      "name": "截图收尾",
      "do": [
        {
          "id": "shot",
          "action": "screenshot",
          "name": "forge-sample-tasks"
        },
        {
          "id": "stop",
          "action": "pie.stop"
        },
        {
          "id": "stopped",
          "action": "wait",
          "until": "pieStopped"
        }
      ]
    }
  ]
}
