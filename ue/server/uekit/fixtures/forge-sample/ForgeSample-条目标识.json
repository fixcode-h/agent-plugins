{
  "kind": "gametest-scenario",
  "schemaVersion": 3,
  "name": "AssetForge 示例界面：按条目标识点列表",
  "_note": "配套「列表条目」页。三种容器写成一张数据表，用 loop in 逐行点、逐行核对状态栏：加一种条目只加一行。后半段用 select 按数据选中、scroll 按序号滚动。手动录制时点这页条目上的按钮：仓库按 ItemId 自动认，邮件和技能栏会暂停游戏、在面板上弹窗问用哪个字段认。",
  "revision": 3,
  "tags": ["sample","assetforge","item-key"],
  "stepDelayMs": 200,
  "vars": {
    "crumb": "WBP_ForgeSample:Root/Shell/Main/TopBar/TopRow/Crumb",
    "status": "WBP_ForgeSample:Root/Shell/Main/TopBar/TopRow/StatusChip/Status",
    "back": "WBP_ForgeSample:Root/Shell/Main/TopBar/TopRow/Back",
    "cases": [
      {
        "name": "仓库：按 ItemId 认，第 30 格没滚到先滚过去",
        "target": "WBP_ForgeSample:Root/Shell/Main/Pages/Page_Lists>ListsRoot/ListsBody/BagCard/BagCol/ItemList[ItemId=1030]>SlotBg/SlotCol/BtnUse",
        "expect": "ItemId 1030"
      },
      {
        "name": "邮件：按发送时间认第 6 封",
        "target": "WBP_ForgeSample:Root/Shell/Main/Pages/Page_Lists>ListsRoot/ListsBody/ListsRight/MailCard/MailCol/MailList[SentAt=202611101400]>RowPad/RowBg/RowCols/BtnClaim",
        "expect": "11-10 14:00"
      },
      {
        "name": "技能栏：两个字段一起才唯一，2 级治疗",
        "target": "WBP_ForgeSample:Root/Shell/Main/Pages/Page_Lists>ListsRoot/ListsBody/ListsRight/SkillCard/SkillCol/SkillBar[SkillType=13,Level=2]>CellBg/CellWidth/CellCol/BtnCast",
        "expect": "SkillType 13"
      }
    ]
  },
  "steps": [
    {
      "id": "open",
      "action": "call",
      "script": "AssetForgeSample/common/打开示例界面",
      "with": {"nav":"WBP_ForgeSample:Root/Shell/SideWidth/SideBg/SideCol/Go_Page_Lists__Nav","title":"列表条目"},
      "saveAs": "opened",
      "note": "进图、重置示例界面、切到「列表条目」页"
    },
    {
      "id": "cases",
      "action": "loop",
      "in": "$cases",
      "as": "row",
      "max": 20,
      "note": "每行：按条目标识点按钮，状态栏写出点到的是哪一条",
      "do": [
        {"id":"clickRow","action":"click","target":"$row.target"},
        {"id":"checkRow","action":"assert","expr":"contains(text($status), $row.expect)"}
      ]
    },
    {
      "id": "pick",
      "action": "group",
      "name": "选中和滚动：直接改列表状态（准备数据用，录制器不写这些）",
      "do": [
        {
          "id": "selectItem",
          "action": "select",
          "target": "WBP_ForgeSample:Root/Shell/Main/Pages/Page_Lists>ListsRoot/ListsBody/BagCard/BagCol/ItemList",
          "property": "ItemId",
          "equals": 1040,
          "note": "按数据对象的属性选中"
        },
        {
          "id": "selectedItem",
          "action": "assert",
          "target": "WBP_ForgeSample:Root/Shell/Main/Pages/Page_Lists>ListsRoot/ListsBody/BagCard/BagCol/ItemList",
          "selectedProperty": "ItemId",
          "equals": 1040
        },
        {
          "id": "selectMail",
          "action": "select",
          "target": "WBP_ForgeSample:Root/Shell/Main/Pages/Page_Lists>ListsRoot/ListsBody/ListsRight/MailCard/MailCol/MailList",
          "index": 3,
          "note": "按序号选中第 4 封"
        },
        {
          "id": "mailSelected",
          "action": "assert",
          "target": "WBP_ForgeSample:Root/Shell/Main/Pages/Page_Lists>ListsRoot/ListsBody/ListsRight/MailCard/MailCol/MailList",
          "stateKey": "selectedCount",
          "equals": 1
        },
        {
          "id": "scrollLast",
          "action": "scroll",
          "target": "WBP_ForgeSample:Root/Shell/Main/Pages/Page_Lists>ListsRoot/ListsBody/BagCard/BagCol/ItemList",
          "index": 47,
          "note": "列表族用 index 滚到最后一格"
        },
        {
          "id": "lastShown",
          "action": "assert",
          "target": "WBP_ForgeSample:Root/Shell/Main/Pages/Page_Lists>ListsRoot/ListsBody/BagCard/BagCol/ItemList[ItemId=1048]",
          "exists": true
        },
        {
          "id": "itemCount",
          "action": "api",
          "api": "Widget.ItemCount",
          "args": {"target":"WBP_ForgeSample:Root/Shell/Main/Pages/Page_Lists>ListsRoot/ListsBody/BagCard/BagCol/ItemList"},
          "saveAs": "itemCount",
          "expect": {"equals":48},
          "note": "条目数含没滚到的（按数据对象数）"
        }
      ]
    },
    {
      "id": "close",
      "action": "group",
      "name": "截图收尾",
      "do": [
        {"id":"shot","action":"screenshot","name":"forge-sample-lists"},
        {"id":"stop","action":"pie.stop"},
        {"id":"stopped","action":"wait","until":"pieStopped"}
      ]
    }
  ]
}
