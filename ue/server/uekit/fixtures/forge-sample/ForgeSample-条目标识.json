{
  "kind": "gametest-scenario",
  "schemaVersion": 5,
  "name": "AssetForge 示例界面：按条目标识点列表",
  "_note": "配套「列表条目」页。三种容器写成一张数据表，用 loop in 逐行点、逐行核对状态栏：加一种条目只加一行。后半段用 select 按数据选中、scroll 按序号滚动。手动录制时点这页条目上的按钮：仓库按 ItemId 自动认，邮件和技能栏会暂停游戏、在面板上弹窗问用哪个字段认。",
  "revision": 3,
  "tags": [
    "sample",
    "assetforge",
    "item-key"
  ],
  "stepDelayMs": 200,
  "steps": [
    {
      "id": "open",
      "action": "call",
      "script": "AssetForgeSample/common/打开示例界面",
      "with": {
        "nav": "Go_Page_Lists__Nav",
        "title": "列表条目"
      },
      "saveAs": "opened",
      "note": "进图、重置示例界面、切到「列表条目」页"
    },
    {
      "id": "cases",
      "action": "group",
      "name": "按条目标识点按钮，状态栏写出点到的是哪一条",
      "note": "每种容器一组：条目类 + 在哪个容器里 + 唯一标识组（ListView 族按数据对象 @item.，面板容器按条目自己的 @.）",
      "do": [
        {
          "id": "click_bag",
          "action": "click",
          "note": "仓库：按 ItemId 认，第 30 格没滚到先滚过去",
          "target": {
            "obj": {
              "class": "ForgeBagSlot",
              "in": {
                "obj": {
                  "class": "WBP_ForgeSample"
                },
                "part": "Page_Lists.ItemList"
              },
              "ident": [
                {
                  "prop": "@item.ItemId",
                  "op": "eq",
                  "value": 1030
                }
              ]
            },
            "part": "BtnUse"
          }
        },
        {
          "id": "check_bag",
          "action": "assert",
          "cond": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "prop": "@/Status:text",
            "op": "contains",
            "value": "ItemId 1030"
          }
        },
        {
          "id": "click_mail",
          "action": "click",
          "note": "邮件：按发送时间认第 6 封",
          "target": {
            "obj": {
              "class": "ForgeMailRow",
              "in": {
                "obj": {
                  "class": "WBP_ForgeSample"
                },
                "part": "Page_Lists.MailList"
              },
              "ident": [
                {
                  "prop": "@item.SentAt",
                  "op": "eq",
                  "value": 202611101400
                }
              ]
            },
            "part": "BtnClaim"
          }
        },
        {
          "id": "check_mail",
          "action": "assert",
          "cond": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "prop": "@/Status:text",
            "op": "contains",
            "value": "11-10 14:00"
          }
        },
        {
          "id": "click_skill",
          "action": "click",
          "note": "技能栏：两个字段一起才唯一，2 级治疗",
          "target": {
            "obj": {
              "class": "ForgeSkillCell",
              "in": {
                "obj": {
                  "class": "WBP_ForgeSample"
                },
                "part": "Page_Lists.SkillBar"
              },
              "ident": [
                {
                  "prop": "@.SkillType",
                  "op": "eq",
                  "value": 13
                },
                {
                  "prop": "@.Level",
                  "op": "eq",
                  "value": 2
                }
              ]
            },
            "part": "BtnCast"
          }
        },
        {
          "id": "check_skill",
          "action": "assert",
          "cond": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "prop": "@/Status:text",
            "op": "contains",
            "value": "SkillType 13"
          }
        }
      ]
    },
    {
      "id": "pick",
      "action": "group",
      "name": "选中和滚动：直接改列表状态（准备数据用，录制器不写这些）",
      "do": [
        {
          "id": "selectItem",
          "action": "select",
          "target": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "part": "Page_Lists.ItemList"
          },
          "property": "ItemId",
          "equals": 1040,
          "note": "按数据对象的属性选中"
        },
        {
          "id": "selectedItem",
          "action": "assert",
          "cond": {
            "obj": {
              "class": "ForgeBagSlot",
              "in": {
                "obj": {
                  "class": "WBP_ForgeSample"
                },
                "part": "Page_Lists.ItemList"
              },
              "ident": [
                {
                  "prop": "@item.ItemId",
                  "op": "eq",
                  "value": 1040
                }
              ]
            },
            "prop": "@:selected",
            "op": "is",
            "value": true
          }
        },
        {
          "id": "selectMail",
          "action": "select",
          "target": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "part": "Page_Lists.MailList"
          },
          "index": 3,
          "note": "按序号选中第 4 封"
        },
        {
          "id": "mailSelected",
          "action": "assert",
          "cond": {
            "obj": {
              "class": "ForgeMailRow",
              "in": {
                "obj": {
                  "class": "WBP_ForgeSample"
                },
                "part": "Page_Lists.MailList"
              },
              "ident": [
                {
                  "prop": "@:selected",
                  "op": "is",
                  "value": true
                }
              ]
            },
            "prop": "@:exists",
            "op": "is",
            "value": true
          },
          "note": "选中的那一封只有一封（多了会报命中多个）"
        },
        {
          "id": "scrollLast",
          "action": "scroll",
          "target": {
            "obj": {
              "class": "WBP_ForgeSample"
            },
            "part": "Page_Lists.ItemList"
          },
          "index": 47,
          "note": "列表族用 index 滚到最后一格"
        },
        {
          "id": "lastShown",
          "action": "assert",
          "cond": {
            "obj": {
              "class": "ForgeBagSlot",
              "in": {
                "obj": {
                  "class": "WBP_ForgeSample"
                },
                "part": "Page_Lists.ItemList"
              },
              "ident": [
                {
                  "prop": "@item.ItemId",
                  "op": "eq",
                  "value": 1048
                }
              ]
            },
            "prop": "@:exists",
            "op": "is",
            "value": true
          }
        },
        {
          "id": "itemCount",
          "action": "api",
          "api": "Widget.ItemCount",
          "args": {
            "target": {
              "obj": {
                "class": "WBP_ForgeSample"
              },
              "part": "Page_Lists.ItemList"
            }
          },
          "saveAs": "itemCount",
          "expect": {
            "equals": 48
          },
          "note": "条目数含没滚到的（按数据对象数）"
        }
      ]
    },
    {
      "id": "close",
      "action": "group",
      "name": "截图收尾",
      "do": [
        {
          "id": "shot",
          "action": "screenshot",
          "name": "forge-sample-lists"
        },
        {
          "id": "stop",
          "action": "pie.stop"
        },
        {
          "id": "stopped",
          "action": "wait",
          "until": "pieStopped"
        }
      ]
    }
  ]
}
