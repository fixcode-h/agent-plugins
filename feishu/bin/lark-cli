#!/bin/sh
# 飞书插件放在 Agent 的 PATH 最前面的拦截垫片：Agent 在终端（或脚本里）直接调 lark-cli 会先碰到这里。
# 飞书只能经 feishu_* 工具读写，权限由面板按用户给的链接管。用户放行了原始命令、或者在插件设置里打开了
# 「允许终端直接调用 lark-cli」时（FEISHU_LARK_RAW=1 / true），去掉自己所在的目录再交给真正的 lark-cli。
if [ "$FEISHU_LARK_RAW" = "1" ] || [ "$FEISHU_LARK_RAW" = "true" ]; then
  self_dir=$(cd "$(dirname "$0")" && pwd)
  PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -vxF "$self_dir" | paste -sd: -)
  export PATH
  exec lark-cli "$@"
fi
echo "飞书只能用 feishu_* 工具读写（权限由 Agent 面板管），不能在终端直接调 lark-cli。用户明确要求时请用户放行，放行后在命令前加 FEISHU_LARK_RAW=1。" >&2
exit 126
