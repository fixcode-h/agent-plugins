{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["sdk", "*/server", "*/web"],
  // ui-design、video 照面板源码布局放文件、类型从面板取，各自用自己的 tsconfig 检查
  "exclude": ["ui-design", "video"]
}
